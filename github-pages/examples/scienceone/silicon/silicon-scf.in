&CONTROL
  calculation = 'scf'
  prefix = 'silicon_test'
  pseudo_dir = './'
  outdir = './tmp'
  tstress = .true.
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 8
  ntyp = 1
  ecutwfc = 30.0
  ecutrho = 120.0
  input_dft = 'PZ'
  occupations = 'fixed'
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.7
/

ATOMIC_SPECIES
Si 28.0855 Si.pz-vbc.UPF

CELL_PARAMETERS angstrom
5.431 0.000 0.000
0.000 5.431 0.000
0.000 0.000 5.431

ATOMIC_POSITIONS crystal
Si 0.000 0.000 0.000
Si 0.000 0.500 0.500
Si 0.500 0.000 0.500
Si 0.500 0.500 0.000
Si 0.250 0.250 0.250
Si 0.250 0.750 0.750
Si 0.750 0.250 0.750
Si 0.750 0.750 0.250

K_POINTS automatic
4 4 4 0 0 0
