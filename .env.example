# Server-only OpenAI Agent configuration
OPENAI_API_KEY=
OPENAI_AGENT_ENABLED=true
OPENAI_AGENT_MODEL=gpt-5.6-luna

# Dropbox -> OpenAI vector-store knowledge sync
DROPBOX_KNOWLEDGE_ENABLED=false
DROPBOX_DATA_FOLDER=/ARPES-Agent-Data
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
OPENAI_DROPBOX_VECTOR_STORE_NAME=arpes-dropbox-knowledge
DROPBOX_SYNC_MAX_CHANGES=4
DROPBOX_MAX_FILE_BYTES=8388608
DROPBOX_ZIP_MAX_FILES=50
DROPBOX_ZIP_MAX_ENTRY_BYTES=8388608
DROPBOX_ZIP_MAX_UNCOMPRESSED_BYTES=20971520

# Optional: use a vector store that was created manually
# OPENAI_VECTOR_STORE_ID=vs_...

# Short-term testing only; prefer refresh-token credentials above
# DROPBOX_ACCESS_TOKEN=

# Server-side secrets. Copy this file to .env and fill values locally.
MP_API_KEY=
WOS_API_KEY=
